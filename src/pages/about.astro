---
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('blog', 'about');
if (!about) throw new Error('About content was not found at src/data/blog/about.md');
const content = await marked.parse(about.data.content);
---

<BaseLayout title="About — Kennedy Ekanem" description={about.data.description}>
  <article class="about-page">
    <div class="about-shell">
      <header class="about-hero">
        <div>
          <p class="about-kicker">Hello, I’m</p>
          <h1>Kennedy Ekanem</h1>
          <p class="about-role">ITOps · SRE · Open Source</p>
          <nav class="about-links" aria-label="Profile links">
            <a href="https://www.linkedin.com/in/fusedtechie/" target="_blank">LinkedIn ↗</a>
            <a href="mailto:hello@fusedtechie.me">Email ↗</a>
            <a href="https://github.com/KenEkanem" target="_blank">GitHub ↗</a>

          </nav>
        </div>
        <div class="profile-mark" aria-hidden="true"><span>KE</span></div>
      </header>

      <section class="about-content" aria-labelledby="about-heading">
        <div class="about-label"><h2 id="about-heading">About</h2><span></span></div>
        <div class="markdown" set:html={content} />
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page{min-height:calc(100vh - 76px);background:#090a09;color:#e9e7e1;padding:72px 24px 110px;font-family:Mono,monospace}.about-shell{width:min(100%,760px);margin:auto}.about-hero{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:60px;align-items:center;padding:12px 0 62px;border-bottom:1px solid #292a28}.about-kicker{margin:0 0 8px;color:#777873;font-size:12px;text-transform:uppercase;letter-spacing:.14em}.about-hero h1{margin:0;font:700 clamp(38px,6vw,54px)/1.05 Mono,monospace;letter-spacing:-.045em}.about-role{margin:18px 0 0;color:#989994;font-size:14px}.about-links{display:flex;gap:30px;margin-top:28px;font-size:12px}.about-links a{color:#c7c6c0}.about-links a:hover{color:#fff}.profile-mark{width:142px;height:142px;padding:10px;border:1px solid #373936;border-radius:50%;background:#181a18;box-shadow:0 0 0 10px #111210;display:grid;place-items:center}.profile-mark span{width:100%;height:100%;border-radius:50%;background:linear-gradient(145deg,#ece7dc,#b8aa92);color:#111;display:grid;place-items:center;font:700 34px var(--serif)}.about-content{padding-top:52px}.about-label h2{margin:0;color:#f1efe9;font:700 20px Mono}.about-label span{display:block;width:36px;height:2px;margin-top:10px;background:#e8e5de}.markdown{margin-top:20px;color:#999a96;font-size:14px;line-height:1.85}.markdown :global(p){margin:0 0 20px}.markdown :global(h2){margin:42px 0 16px;color:#e7e5df;font:700 16px Mono}.markdown :global(ul){display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0 28px;padding:0;list-style:none}.markdown :global(li){padding:14px;border:1px solid #30312f;border-radius:4px;color:#aaa}.markdown :global(li)::before{content:'▸';margin-right:10px;color:#e8e5de}.markdown :global(a){color:#f0eee8;border-bottom:1px solid #555}.markdown :global(a:hover){border-color:#fff}
  @media(max-width:650px){.about-page{padding:52px 20px 80px}.about-hero{grid-template-columns:1fr;gap:42px;padding-bottom:48px}.profile-mark{grid-row:1;width:110px;height:110px}.about-hero h1{font-size:38px}.about-links{gap:20px;flex-wrap:wrap}.markdown :global(ul){grid-template-columns:1fr 1fr}}
</style>
