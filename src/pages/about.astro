---
import { getEntry } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../layouts/BaseLayout.astro';

const about = await getEntry('blog', 'about');
if (!about) throw new Error('About content was not found at src/data/blog/about.md');
const content = await marked.parse(about.data.content);
---

<BaseLayout title="About — Kennedy Ekanem" description={about.data.description}>
  <article class="about-page">
    <div class="about-shell">
      <header class="about-hero">
        <div>
          <p class="about-kicker">Hello, I’m</p>
          <h1>Kennedy Ekanem</h1>
          <p class="about-role">ITOps · SRE · Open Source</p>
          <nav class="about-links" aria-label="Profile links">
            <a href="https://www.linkedin.com/in/fusedtechie/" target="_blank">LinkedIn ↗</a>
            <a href="mailto:hello@fusedtechie.me">Email ↗</a>
            <a href="https://github.com/KenEkanem" target="_blank">GitHub ↗</a>

          </nav>
        </div>
        <div class="profile-mark" aria-hidden="true"><span>KE</span></div>
      </header>

      <section class="about-content" aria-label="About Kennedy Ekanem">
        <div class="markdown" set:html={content} />
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page{min-height:calc(100vh - 76px);background:var(--paper);color:var(--ink);padding:72px 24px 110px;font-family:Mono,monospace;transition:background .2s,color .2s}.about-shell{width:min(100%,760px);margin:auto}.about-hero{display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:60px;align-items:center;padding:12px 0 62px;border-bottom:1px solid var(--line)}.about-kicker{margin:0 0 8px;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.14em}.about-hero h1{margin:0;font:700 clamp(38px,6vw,54px)/1.05 Mono,monospace;letter-spacing:-.045em}.about-role{margin:18px 0 0;color:var(--muted);font-size:14px}.about-links{display:flex;gap:30px;margin-top:28px;font-size:12px}.about-links a{color:var(--ink)}.about-links a:hover{opacity:.6}.profile-mark{width:142px;height:142px;padding:10px;border:1px solid var(--line);border-radius:50%;background:var(--soft);box-shadow:0 0 0 10px color-mix(in srgb,var(--soft) 70%,transparent);display:grid;place-items:center}.profile-mark span{width:100%;height:100%;border-radius:50%;background:linear-gradient(145deg,var(--ink),var(--muted));color:var(--paper);display:grid;place-items:center;font:700 34px var(--serif)}.about-content{padding-top:52px}.markdown{color:var(--muted);font-size:14px;line-height:1.85}.markdown :global(p){margin:0 0 20px}.markdown :global(h2){margin:42px 0 10px;color:var(--ink);font:700 16px Mono}.markdown :global(ul){display:grid;grid-template-columns:1fr 1fr;margin:8px 0 28px;padding:0;list-style:none;border-top:1px solid var(--line)}.markdown :global(li){padding:11px 0;border-bottom:1px solid var(--line);color:var(--muted)}.markdown :global(li:nth-child(odd)){padding-right:18px}.markdown :global(li:nth-child(even)){padding-left:18px;border-left:1px solid var(--line)}.markdown :global(a){color:var(--ink);border-bottom:1px solid var(--line)}.markdown :global(a:hover){border-color:var(--ink)}
  @media(max-width:650px){.about-page{padding:52px 20px 80px}.about-hero{grid-template-columns:1fr;gap:42px;padding-bottom:48px}.profile-mark{grid-row:1;width:110px;height:110px}.about-hero h1{font-size:38px}.about-links{gap:20px;flex-wrap:wrap}.markdown :global(ul){grid-template-columns:1fr}.markdown :global(li:nth-child(n)){padding:11px 0;border-left:0}}
</style>
