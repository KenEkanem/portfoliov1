---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
const posts = (await getCollection('blog', ({ data }) => data.type === 'post')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()).slice(0, 3);
---
<BaseLayout>
  <section class="hero grid-pattern">
    <div class="hero-inner">
      <span class="eyebrow">ITOps · Programs · Community</span>
      <h1>I build systems that help <em>people and ideas</em> scale.</h1>
      <div class="hero-actions"><a class="button" href="#work">Explore my work ↓</a><a class="button button-outline" href="/blog">Read my field notes →</a></div>
      <div class="hero-proof"><span>⌁ Infrastructure</span><span>◎ Community systems</span><span>◇ Open source</span></div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="work-heading">
      <div><h2>Useful systems,<br />built for <em>real people.</em></h2></div>
      <p>A focused selection of infrastructure and product work, what I built, why it mattered, and the role I played.</p>
    </div>
    <div class="projects">
      <ProjectCard number="01" title="Dragnet ERP" href="/projects/dragnet-erp" description="An internal digital workplace connecting employees to company information, resources, analytics, and business systems through one unified experience." role="IT Support Engineer" builtFor="Dragnet Solutions Limited" year="2026" tags={['React', 'Microsoft 365', 'Microsoft Graph']} />
      <ProjectCard number="02" title="SortApp + CheckinApp" href="/projects/sortapp" description="A modular guest operations system that turns CSV data into personalized QR access cards, delivers them by email, and powers fast event check-ins." role="Product engineering" builtFor="Shamsuddeen Usman" year="2024" tags={['Automation', 'QR access', 'Events']} />
      <ProjectCard number="03" title="Landest Infrastructure" href="/projects/landest" description="Production infrastructure for a property platform: containerized microservices, banking integrations, email, and end-to-end observability on AWS." role="DevOps & infrastructure" builtFor="Xanotech Solutions" year="2024" tags={['AWS', 'Containers', 'OpenTelemetry']} />
    </div>
  </section>

  <section class="dark-section" id="about">
    <div class="dark-intro"><span class="eyebrow">Beyond the terminal</span><h2>Technology is a<br /><em>people practice.</em></h2><p>My work sits where infrastructure, programs, and community meet. I care about the conditions that let good technology and the people behind it thrive.</p></div>
    <div class="principles">
      <article><span>01</span><div class="icon-box">⌘</div><h3>Build</h3><p>Reliable systems begin with curiosity, clear thinking, and respect for the people who depend on them.</p></article>
      <article><span>02</span><div class="icon-box">◎</div><h3>Grow in public</h3><p>I share the lessons, rough edges, and useful patterns so the next person has a shorter path.</p></article>
      <article><span>03</span><div class="icon-box">◇</div><h3>Make room</h3><p>Though not perfect, I help new contributors find community and move from interest to impact.</p></article>
    </div>
  </section>

  <section class="section writing-section">
    <div class="section-heading compact"><div><span class="eyebrow">From the notebook</span><h2>Field notes & ideas</h2></div><a class="text-link" href="/blog">View all writing →</a></div>
    <div class="post-grid">{posts.map(post => <PostCard post={post} />)}</div>
  </section>

  <section class="cta grid-pattern"><span class="eyebrow">Have something interesting in mind?</span><h2>Let's make it<br /><em>real together.</em></h2><a class="button" href="mailto:hello@fusedtechie.me">Start a conversation ↗</a></section>
</BaseLayout>
