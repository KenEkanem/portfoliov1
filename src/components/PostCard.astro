---
const { post } = Astro.props;
const date = post.data.published.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<article class="post-card">
  <a href={`/blog/${post.id}/`}>
    <span class="eyebrow">{post.data.category}</span>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="post-meta"><span>{date}</span><span>·</span><span>{post.data.readTime}</span><span class="arrow">↗</span></div>
  </a>
</article>
